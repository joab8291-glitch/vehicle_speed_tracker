[Unit]
Description=Vehicle Speed Tracker (RTSP CCTV)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/vehicle-speed-tracker
EnvironmentFile=/opt/vehicle-speed-tracker/.env
ExecStart=/opt/vehicle-speed-tracker/venv/bin/python vehicle_speed_tracker.py --config config.yaml
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

